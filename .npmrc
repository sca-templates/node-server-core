; Publishing is driven by CI, and CI checks out a tag: a detached HEAD fails
; pnpm's publish-branch check (ERR_PNPM_GIT_UNKNOWN_BRANCH) even on a pristine
; tree. Disabling the checks repo-wide is the only way a tag build can publish.
; The equivalent CLI flag, --no-git-checks, is deliberately not used: pnpm
; forwards it to npm, which does not know it and warns that it will stop working.
git-checks=false
